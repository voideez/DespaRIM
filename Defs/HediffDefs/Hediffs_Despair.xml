<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Visible marker of the break in the health tab. Does nothing on its own.
    On a timer death it is passed to Pawn.Kill as the culprit, so the vanilla
    "Death" letter reads: "... died because of: suicidal despair".
    Removed on rescue.
  -->
  <HediffDef>
    <defName>DespaRIM_DespairHediff</defName>
    <label>suicidal despair</label>
    <labelNoun>suicidal despair</labelNoun>
    <description>A black, viscous emptiness that drowns every thought. This person has locked themselves away intending to end their life, and no longer expects anyone to come.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.58, 0.82)</defaultLabelColor>
    <isBad>true</isBad>
    <makesSickThought>false</makesSickThought>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <tendable>false</tendable>
  </HediffDef>

</Defs>
